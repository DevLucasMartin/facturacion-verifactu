# ============================================================================
#  PLANTILLA de configuración — copiar a .env y rellenar para cada cliente.
#      copy .env.example .env       (Windows)
#  Ver la guía "Alta de cliente nuevo" en el README.
#  IMPORTANTE: no pongas comentarios al final de una línea de valor; van en su
#  propia línea (Docker mete todo lo que hay tras el "=" dentro del valor).
#
#  LEYENDA:
#    [OBLIGATORIO] hay que rellenarlo sí o sí.
#    [OPCIONAL]    puede quedar vacío (o dejar el valor por defecto).
# ============================================================================

# --- Puertos expuestos al host (Windows) ---
# Navegador -> http://localhost:8080/SistemaGestionFacturas/
# [OBLIGATORIO] (por defecto 8080; cámbialo solo si el puerto está ocupado)
APP_PORT=8080
# [OPCIONAL] Solo si destapas el puerto de la BD (gestor externo). NO uses 3307 si hay XAMPP.
DB_HOST_PORT=3308

# --- Base de datos ---
# Dirección INTERNA entre contenedores. El MariaDB del cliente escucha en 3306.
# [OBLIGATORIO] deja estos 4 tal cual (config interna, no la toques)
DB_HOST=db
DB_PORT=3306
DB_NAME=verifactu
DB_USER=verifactu
# [OBLIGATORIO] pon una contraseña tuya (evita el carácter #)
DB_PASSWORD=cambia_esta_password
# [OBLIGATORIO] pon otra contraseña (root)
DB_ROOT_PASSWORD=cambia_esta_password_root

# --- Servicio de conversión a PDF (Gotenberg) ---
# [OBLIGATORIO] deja el valor por defecto (config interna, no la toques)
GOTENBERG_URL=http://gotenberg:3000

# --- Datos de la empresa emisora (salen en las facturas) ---
# OJO: EMPRESA_NIF y EMPRESA_RAZON_SOCIAL deben coincidir con el titular del
# certificado digital o la AEAT rechazará TODAS las facturas.
# [OBLIGATORIO] debe coincidir con el titular del certificado
EMPRESA_RAZON_SOCIAL=
# [OBLIGATORIO] debe coincidir con el titular del certificado
EMPRESA_NIF=
# [OPCIONAL]
EMPRESA_TELEFONO=
# [OPCIONAL]
EMPRESA_EMAIL=
# [OPCIONAL]
EMPRESA_WEB=
# [OBLIGATORIO] zona horaria (por defecto Europe/Madrid)
EMPRESA_TIMEZONE=Europe/Madrid
# [OPCIONAL] IBAN / datos de pago que salen en la factura
EMPRESA_DATOS_BANCARIOS=
# [OBLIGATORIO] domicilio fiscal (aparece en la factura)
EMPRESA_DIRECCION=
# [OBLIGATORIO] domicilio fiscal
EMPRESA_CODIGO_POSTAL=
# [OBLIGATORIO] domicilio fiscal
EMPRESA_POBLACION=
# [OBLIGATORIO] domicilio fiscal
EMPRESA_PROVINCIA=

# --- SMTP (envío de facturas por email) ---
# [OPCIONAL] todo este bloque; solo si quieres enviar facturas por correo.
# Para Gmail, SMTP_PASSWORD es una "contraseña de aplicación", no la del correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=tls
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# --- Verifactu / AEAT ---
# [OBLIGATORIO] entorno: pruebas | produccion (produccion solo con cert real del cliente)
VERIFACTU_ENTORNO=pruebas
# [OBLIGATORIO] nombre del archivo .p12 que dejaste en src/storage/certs/
VERIFACTU_CERT_ARCHIVO=
# [OBLIGATORIO] contraseña del certificado .p12
VERIFACTU_CERT_PASSWORD=
# [OBLIGATORIO] true/false — envío automático a la AEAT
VERIFACTU_AUTO_ENVIO=false
