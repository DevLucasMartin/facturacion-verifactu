# Configuración por cliente (contiene secretos: NUNCA se versiona)
.env

# Certificados digitales de clientes
src/storage/certs/*.p12
src/storage/certs/*.pfx

# Datos generados en tiempo de ejecución
src/storage/logs/*.log
src/storage/pdf/*
src/storage/xml/*
!src/storage/**/.gitignore

# Sistema
Thumbs.db
.DS_Store
