Options -Indexes

# ─── Headers de seguridad ────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # Evita que el navegador adivine el MIME type del recurso
    Header always set X-Content-Type-Options "nosniff"

    # Bloquea que la app se incruste en iframes de otros dominios (anti-clickjacking)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Controla qué información de referencia se envía en peticiones externas
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Deshabilita funciones del navegador que esta app no necesita
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

# Bloquear acceso a archivos sensibles de configuración
<FilesMatch "\.(sql|json|lock|md|log|sh|env|yml|yaml|xml|ini|dist)$">
    Require all denied
</FilesMatch>

RewriteEngine On

# Redirigir el raíz al index.php
RewriteRule ^$ index.php [L]

# Bloquear y redirigir acceso directo a directorios privados → login
RewriteRule ^(vendor|tests|Front)(/.*)?$ /SistemaGestionFacturas/index.php [L,R=302]
RewriteRule ^src/(config|core|models|controllers|services|libs|templates|storage)(/.*)?$ /SistemaGestionFacturas/index.php [L,R=302]

# Redirigir navegación por directorios al login (cuando no se llega por un archivo real)
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ /SistemaGestionFacturas/index.php [L,R=302]
